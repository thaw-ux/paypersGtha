# =================================================================
# PAYPERS AI SELF-HOSTED CONFIGURATION
# =================================================================

# 1. Google Gemini AI Engine
# Get free API key from https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...

# 2. Google Cloud Workspace (Google Drive & Google Sheets)
# Service Account Email & Private Key (or JSON credentials)
GOOGLE_SERVICE_ACCOUNT_EMAIL=paypers-service@your-project.iam.gserviceaccount.com
# Note: In .env, replace newlines in private key with \n
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC7...\n-----END PRIVATE KEY-----\n"
# Or provide absolute path to service-account.json file:
GOOGLE_APPLICATION_CREDENTIALS=

# Google Sheets Database ID (Found in Sheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
GOOGLE_SPREADSHEET_ID=1xYz...
# Sheet Name (tab name, default: Transactions)
GOOGLE_SHEET_NAME=Transactions

# Google Drive Root Folder ID where receipts are saved (Found in Drive Folder URL: https://drive.google.com/drive/folders/<FOLDER_ID>)
GOOGLE_DRIVE_FOLDER_ID=1aBc...

# 3. LINE Official Account (LINE Messaging API)
# Get from LINE Developers Console: https://developers.line.biz/
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# 4. Web Application Host URL (Used for generating secure preview links and webhook callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
